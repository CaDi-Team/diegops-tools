root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Rust uses 4-space indentation (enforced by rustfmt, not editorconfig)
[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# TOML files (Cargo.toml, etc.)
[*.toml]
indent_size = 4
